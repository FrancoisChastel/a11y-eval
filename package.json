{
  "name": "a11y-eval",
  "version": "0.12.0",
  "description": "WCAG 2.2 AA evaluation tool for repos and running apps — framework detection, static source scan, dev-server start, multi-page crawl, axe-core + custom Playwright checks, with a stable JSON contract for agent consumption",
  "type": "module",
  "bin": {
    "a11y-eval": "./src/cli.ts"
  },
  "scripts": {
    "eval": "node src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "author": "François Chastel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/a11y-eval.git"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "axe-core",
    "playwright",
    "eslint",
    "crawler"
  ],
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@guidepup/guidepup": "^0.34.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "franc-min": "^6.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/FrancoisChastel/a11y-eval#readme",
  "bugs": {
    "url": "https://github.com/FrancoisChastel/a11y-eval/issues"
  }
}
